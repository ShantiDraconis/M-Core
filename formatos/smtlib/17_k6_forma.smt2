; K6: v^T L v = (1/2) sum_{i,j} (v_i - v_j)^2, com (L v)_i = 6 v_i - sum v  (ATK.GeometriaExtra.forma_L6)
(set-logic QF_NRA)
(declare-const a Real) (declare-const b Real) (declare-const c Real)
(declare-const d Real) (declare-const e Real) (declare-const f Real)
(define-fun S () Real (+ a b c d e f))
(define-fun lhs () Real (+ (* a (- (* 6.0 a) S)) (* b (- (* 6.0 b) S)) (* c (- (* 6.0 c) S))
                           (* d (- (* 6.0 d) S)) (* e (- (* 6.0 e) S)) (* f (- (* 6.0 f) S))))
(define-fun sq ((x Real)) Real (* x x))
(define-fun rhs () Real (+ (sq (- a b)) (sq (- a c)) (sq (- a d)) (sq (- a e)) (sq (- a f))
                           (sq (- b c)) (sq (- b d)) (sq (- b e)) (sq (- b f))
                           (sq (- c d)) (sq (- c e)) (sq (- c f))
                           (sq (- d e)) (sq (- d f)) (sq (- e f))))
(assert (not (= lhs rhs)))
(check-sat)

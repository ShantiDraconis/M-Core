; Expansão quártica G = x^4 + 2(g^2-d^2)x^2 + (g^2+d^2)^2, x = s - 1/2 = a + b i (identidade em componentes).
(set-logic QF_NRA)
(declare-const a Real) (declare-const b Real) (declare-const d Real) (declare-const g Real)
; u1 = x - d, u2 = x + d
(define-fun sqr ((p Real) (q Real)) Real (- (* p p) (* q q)))
(define-fun sqi ((p Real) (q Real)) Real (* 2.0 p q))
(define-fun A1r () Real (+ (sqr (- a d) b) (* g g)))
(define-fun A1i () Real (sqi (- a d) b))
(define-fun A2r () Real (+ (sqr (+ a d) b) (* g g)))
(define-fun A2i () Real (sqi (+ a d) b))
(define-fun Gr () Real (- (* A1r A2r) (* A1i A2i)))
(define-fun Gi () Real (+ (* A1r A2i) (* A1i A2r)))
(define-fun x2r () Real (sqr a b))
(define-fun x2i () Real (sqi a b))
(define-fun x4r () Real (sqr x2r x2i))
(define-fun x4i () Real (sqi x2r x2i))
(define-fun k () Real (* 2.0 (- (* g g) (* d d))))
(define-fun c () Real (* (+ (* g g) (* d d)) (+ (* g g) (* d d))))
(define-fun Qr () Real (+ x4r (* k x2r) c))
(define-fun Qi () Real (+ x4i (* k x2i)))
(assert (not (and (= Gr Qr) (= Gi Qi))))
(check-sat)

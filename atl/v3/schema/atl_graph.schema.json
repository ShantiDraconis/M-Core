{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://m-core.local/atl/v3/atl_graph.schema.json",
  "title":"ATL v3 canonical graph",
  "type":"object",
  "required":["schema","graph_version","nodes","edges","log"],
  "properties":{
    "schema":{"const":"atl.graph.v3"},
    "graph_version":{"type":"integer","minimum":3},
    "nodes":{"type":"array","items":{"$ref":"#/$defs/node"}},
    "edges":{"type":"array","items":{"$ref":"#/$defs/edge"}},
    "log":{"type":"array","items":{"$ref":"#/$defs/event"}}
  },
  "$defs":{
    "node":{
      "type":"object",
      "required":["id","area","kind","version","formal_statement","semantic_statement","source_files","theorem_names","repo","branch","commit","policy"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "area":{"type":"string","minLength":1},
        "kind":{"enum":["AREA","CLAIM","PRODUCER","LEMMA","BRIDGE","GATE","CERTIFICATE","EXTERNAL_ENDPOINT","MINED_ARTIFACT"]},
        "version":{"type":"integer","minimum":1},
        "formal_statement":{"type":"string"},
        "semantic_statement":{"type":"string"},
        "source_files":{"type":"array","items":{"type":"string"}},
        "theorem_names":{"type":"array","items":{"type":"string"}},
        "repo":{"type":"string"},
        "branch":{"type":"string"},
        "commit":{"type":"string"},
        "policy":{"enum":["constructive","classical_ok"]},
        "statement_hash":{"type":["string","null"]},
        "superseded_by":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "edge":{
      "type":"object",
      "required":["from","to","relation"],
      "properties":{
        "from":{"type":"string"},"to":{"type":"string"},
        "relation":{"enum":["DEPENDS_ON","IMPLIES","PRODUCES","VALIDATES","SUPERSEDES","REPLACES","MINES"]}
      },
      "additionalProperties":false
    },
    "event":{
      "type":"object",
      "required":["ts","node","kind","data"],
      "properties":{
        "ts":{"type":"string"},"node":{"type":"string"},
        "kind":{"enum":["EVIDENCE","OPEN_MATH_REASON","OPEN_MATH_CLASS","PROVENANCE","COST","RETRY","PROMOTION","REGRESSION","FORMULATION_FALSIFIED","MINING_CLASS"]},
        "data":{"type":"object"}
      },
      "additionalProperties":false
    }
  }
}
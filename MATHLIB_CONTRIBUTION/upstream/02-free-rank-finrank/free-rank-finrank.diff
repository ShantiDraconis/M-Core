+/-- The minimal number of generators of a finitely generated torsion-free abelian group is its
+rank as a `ℤ`-module. -/
+theorem _root_.AddGroup.rank_eq_finrank_int [HasUniqueDiv G] [AddGroup.FG G] :
+    AddGroup.rank G = Module.finrank ℤ G := by
+  have : Module.Finite ℤ G := Module.Finite.iff_addGroup_fg.mpr ‹_›
+  refine le_antisymm ?_ ?_
+  · classical
+    let b := Module.finBasis ℤ G
+    have hb : AddSubgroup.closure (Finset.univ.image b : Set G) = ⊤ := by
+      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ,
+        ← Submodule.span_int_eq_addSubgroupClosure, b.span_eq, Submodule.top_toAddSubgroup]
+    exact (AddGroup.rank_le hb).trans (Finset.card_image_le.trans (by simp))
+  · obtain ⟨S, hS, hS'⟩ := AddGroup.rank_spec G
+    have : Submodule.span ℤ (Set.range ((↑) : S → G)) = ⊤ := by
+      refine Submodule.toAddSubgroup_injective ?_
+      rw [Subtype.range_coe_subtype, Finset.setOfPred_mem,
+        Submodule.span_int_eq_addSubgroupClosure, hS', Submodule.top_toAddSubgroup]
+    exact (finrank_le_of_span_eq_top this).trans (by simp [hS])
+
+/-- The free rank of a finitely generated abelian group is its rank as a `ℤ`-module. -/
+theorem freeRank_eq_finrank [AddGroup.FG G] : freeRank G = Module.finrank ℤ G := by
+  rw [freeRank_def, AddGroup.rank_eq_finrank_int]
+  exact finrank_quotient_torsion_eq
+
 end AddCommGroup
 
